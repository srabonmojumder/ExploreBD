# ExploreBD Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (uses port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/explorebd?schema=public

# JWT Authentication Secrets
JWT_ACCESS_SECRET=explorebd_super_secret_access_jwt_key_2026_bd
JWT_REFRESH_SECRET=explorebd_super_secret_refresh_jwt_key_2026_bd
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Optional for Phase 1, ready for Phase 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
